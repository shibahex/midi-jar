{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
        "chordDictionary": {
            "properties": {
                "aliases": {
                    "items": {
                        "items": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "string"
                            }
                        ],
                        "maxItems": 2,
                        "minItems": 2,
                        "type": "array"
                    },
                    "type": "array"
                },
                "defaultNotation": {
                    "enum": [
                        "long",
                        "short",
                        "symbol"
                    ],
                    "type": "string"
                },
                "disabled": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "filterInKey": {
                    "type": "boolean"
                },
                "groupBy": {
                    "enum": [
                        "intervals",
                        "none",
                        "quality"
                    ],
                    "type": "string"
                },
                "hideDisabled": {
                    "type": "boolean"
                },
                "interactive": {
                    "enum": [
                        "detect",
                        "play"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "chordDisplay": {
            "items": {
                "properties": {
                    "allowOmissions": {
                        "type": "boolean"
                    },
                    "chordNotation": {
                        "enum": [
                            "long",
                            "preferred",
                            "short",
                            "symbol"
                        ],
                        "type": "string"
                    },
                    "detectOnRelease": {
                        "type": "boolean"
                    },
                    "displayAltChords": {
                        "type": "boolean"
                    },
                    "displayChord": {
                        "type": "boolean"
                    },
                    "displayIntervals": {
                        "type": "boolean"
                    },
                    "displayKeyboard": {
                        "type": "boolean"
                    },
                    "displayName": {
                        "type": "boolean"
                    },
                    "displayNotation": {
                        "type": "boolean"
                    },
                    "highlightAlterations": {
                        "type": "boolean"
                    },
                    "id": {
                        "type": "string"
                    },
                    "keyboard": {
                        "properties": {
                            "colors": {
                                "properties": {
                                    "black": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    },
                                    "played": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    },
                                    "sustained": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    },
                                    "white": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    },
                                    "wrapped": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    }
                                },
                                "type": "object"
                            },
                            "displaySustained": {
                                "type": "boolean"
                            },
                            "fadeOutDuration": {
                                "type": "number"
                            },
                            "from": {
                                "type": "string"
                            },
                            "keyInfo": {
                                "enum": [
                                    "interval",
                                    "none",
                                    "tonic",
                                    "tonicAndInterval"
                                ],
                                "type": "string"
                            },
                            "keyName": {
                                "enum": [
                                    "none",
                                    "note",
                                    "octave",
                                    "pitchClass"
                                ],
                                "type": "string"
                            },
                            "label": {
                                "enum": [
                                    "chordNote",
                                    "interval",
                                    "none",
                                    "note",
                                    "pitchClass"
                                ],
                                "type": "string"
                            },
                            "sizes": {
                                "properties": {
                                    "bevel": {
                                        "type": "boolean"
                                    },
                                    "height": {
                                        "type": "number"
                                    },
                                    "radius": {
                                        "type": "number"
                                    },
                                    "ratio": {
                                        "type": "number"
                                    }
                                },
                                "type": "object"
                            },
                            "skin": {
                                "enum": [
                                    "classic",
                                    "flat"
                                ],
                                "type": "string"
                            },
                            "textOpacity": {
                                "type": "number"
                            },
                            "to": {
                                "type": "string"
                            },
                            "wrap": {
                                "type": "boolean"
                            }
                        },
                        "type": "object"
                    },
                    "useSustain": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "type": "array"
        },
        "chordQuiz": {
            "properties": {
                "chordNotation": {
                    "enum": [
                        "long",
                        "preferred",
                        "short",
                        "symbol"
                    ],
                    "type": "string"
                },
                "chords": {
                    "description": "Chord types asked in the chord quiz (\"all\" uses the difficulty)",
                    "enum": [
                        "all",
                        "majorMinor",
                        "ninths",
                        "sevenths",
                        "triads",
                        "triadsSevenths"
                    ],
                    "type": "string"
                },
                "customProgressions": {
                    "description": "progressions written by the user, one per line (e.g. \"I vi ii V\")",
                    "type": "string"
                },
                "difficulty": {
                    "enum": [
                        0,
                        1,
                        2,
                        3,
                        4,
                        5
                    ],
                    "type": "number"
                },
                "displayIntervals": {
                    "type": "boolean"
                },
                "displayName": {
                    "type": "boolean"
                },
                "displayReaction": {
                    "type": "boolean"
                },
                "displayRelative": {
                    "type": "boolean"
                },
                "excludedChords": {
                    "description": "chords of the set left out (tonal names, e.g. \"m\" or \"dim\")",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "excludedProgressions": {
                    "description": "progressions left out (ids, e.g. \"ii-V-I\")",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "fingering": {
                    "description": "Hands to display finger numbers for, in learning modes",
                    "enum": [
                        "both",
                        "left",
                        "none",
                        "right"
                    ],
                    "type": "string"
                },
                "gameLength": {
                    "type": "number"
                },
                "gamification": {
                    "type": "boolean"
                },
                "learningMode": {
                    "type": "boolean"
                },
                "mode": {
                    "enum": [
                        "progressions",
                        "random",
                        "randomInKey"
                    ],
                    "type": "string"
                },
                "progressionKey": {
                    "description": "key of the progressions: random, or the current key (notation settings)",
                    "enum": [
                        "current",
                        "random"
                    ],
                    "type": "string"
                },
                "retryUntilCorrect": {
                    "description": "stays on the chord after a wrong answer, until the right chord is played",
                    "type": "boolean"
                },
                "tonics": {
                    "description": "Tonics asked in quizzes: every key, or natural keys only (no sharp or flat)",
                    "enum": [
                        "all",
                        "natural"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "circleOfFifths": {
            "properties": {
                "displayAlterations": {
                    "type": "boolean"
                },
                "displayDegreeLabels": {
                    "type": "boolean"
                },
                "displayDegrees": {
                    "type": "boolean"
                },
                "displayDiminished": {
                    "type": "boolean"
                },
                "displayDominants": {
                    "type": "boolean"
                },
                "displayMajor": {
                    "type": "boolean"
                },
                "displayMinor": {
                    "type": "boolean"
                },
                "displayModes": {
                    "type": "boolean"
                },
                "displaySuspended": {
                    "type": "boolean"
                },
                "highlightInScale": {
                    "type": "boolean"
                },
                "highlightSector": {
                    "enum": [
                        "chord",
                        "notes"
                    ],
                    "type": "string"
                },
                "scale": {
                    "enum": [
                        "major",
                        "minor"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "general": {
            "properties": {
                "launchAtStartup": {
                    "type": "boolean"
                },
                "startMinimized": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "notation": {
            "properties": {
                "accidentals": {
                    "enum": [
                        "flat",
                        "sharp"
                    ],
                    "type": "string"
                },
                "key": {
                    "type": "string"
                },
                "staffClef": {
                    "enum": [
                        "bass",
                        "both",
                        "treble"
                    ],
                    "type": "string"
                },
                "staffTranspose": {
                    "type": "number"
                }
            },
            "type": "object"
        },
        "scaleDegrees": {
            "properties": {
                "displayDegreeName": {
                    "type": "boolean"
                },
                "displayReaction": {
                    "type": "boolean"
                },
                "displayRelative": {
                    "type": "boolean"
                },
                "displayScaleNotes": {
                    "type": "boolean"
                },
                "gameLength": {
                    "type": "number"
                },
                "gamification": {
                    "type": "boolean"
                },
                "learningMode": {
                    "description": "keyboard with the keys of the scale and their degrees",
                    "type": "boolean"
                },
                "mode": {
                    "enum": [
                        "random",
                        "randomInKey"
                    ],
                    "type": "string"
                },
                "scales": {
                    "enum": [
                        "all",
                        "major",
                        "majorMinor",
                        "minor",
                        "minors",
                        "modes",
                        "pentatonics"
                    ],
                    "type": "string"
                },
                "tonics": {
                    "description": "Tonics asked in quizzes: every key, or natural keys only (no sharp or flat)",
                    "enum": [
                        "all",
                        "natural"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "scaleQuiz": {
            "properties": {
                "direction": {
                    "enum": [
                        "down",
                        "up",
                        "upDown"
                    ],
                    "type": "string"
                },
                "displayFormula": {
                    "type": "boolean"
                },
                "displayNoteNames": {
                    "type": "boolean"
                },
                "displayReaction": {
                    "type": "boolean"
                },
                "displayRelative": {
                    "type": "boolean"
                },
                "fingering": {
                    "description": "Hands to display finger numbers for, in learning modes",
                    "enum": [
                        "both",
                        "left",
                        "none",
                        "right"
                    ],
                    "type": "string"
                },
                "gamification": {
                    "type": "boolean"
                },
                "jumpBack": {
                    "type": "boolean"
                },
                "learningMode": {
                    "type": "boolean"
                },
                "mode": {
                    "enum": [
                        "random",
                        "randomInKey",
                        "sequential"
                    ],
                    "type": "string"
                },
                "requiredCleanRuns": {
                    "type": "number"
                },
                "scales": {
                    "enum": [
                        "all",
                        "major",
                        "majorMinor",
                        "minor",
                        "minors",
                        "modes",
                        "pentatonics"
                    ],
                    "type": "string"
                },
                "tonics": {
                    "description": "Tonics asked in quizzes: every key, or natural keys only (no sharp or flat)",
                    "enum": [
                        "all",
                        "natural"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "server": {
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "port": {
                    "type": "number"
                }
            },
            "type": "object"
        }
    },
    "type": "object"
}

