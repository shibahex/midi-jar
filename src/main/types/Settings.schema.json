{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
        "chordDictionary": {
            "properties": {
                "aliases": {
                    "items": {
                        "items": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "string"
                            }
                        ],
                        "maxItems": 2,
                        "minItems": 2,
                        "type": "array"
                    },
                    "type": "array"
                },
                "defaultNotation": {
                    "enum": [
                        "long",
                        "short",
                        "symbol"
                    ],
                    "type": "string"
                },
                "disabled": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "filterInKey": {
                    "type": "boolean"
                },
                "groupBy": {
                    "enum": [
                        "intervals",
                        "none",
                        "quality"
                    ],
                    "type": "string"
                },
                "hideDisabled": {
                    "type": "boolean"
                },
                "interactive": {
                    "enum": [
                        "detect",
                        "play"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "chordDisplay": {
            "items": {
                "properties": {
                    "allowOmissions": {
                        "type": "boolean"
                    },
                    "chordNotation": {
                        "enum": [
                            "long",
                            "preferred",
                            "short",
                            "symbol"
                        ],
                        "type": "string"
                    },
                    "detectOnRelease": {
                        "type": "boolean"
                    },
                    "displayAltChords": {
                        "type": "boolean"
                    },
                    "displayChord": {
                        "type": "boolean"
                    },
                    "displayIntervals": {
                        "type": "boolean"
                    },
                    "displayKeyboard": {
                        "type": "boolean"
                    },
                    "displayName": {
                        "type": "boolean"
                    },
                    "displayNotation": {
                        "type": "boolean"
                    },
                    "highlightAlterations": {
                        "type": "boolean"
                    },
                    "id": {
                        "type": "string"
                    },
                    "keyboard": {
                        "properties": {
                            "colors": {
                                "properties": {
                                    "black": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    },
                                    "played": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    },
                                    "sustained": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    },
                                    "white": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    },
                                    "wrapped": {
                                        "type": [
                                            "null",
                                            "string"
                                        ]
                                    }
                                },
                                "type": "object"
                            },
                            "displaySustained": {
                                "type": "boolean"
                            },
                            "fadeOutDuration": {
                                "type": "number"
                            },
                            "from": {
                                "type": "string"
                            },
                            "keyInfo": {
                                "enum": [
                                    "interval",
                                    "none",
                                    "tonic",
                                    "tonicAndInterval"
                                ],
                                "type": "string"
                            },
                            "keyName": {
                                "enum": [
                                    "none",
                                    "note",
                                    "octave",
                                    "pitchClass"
                                ],
                                "type": "string"
                            },
                            "label": {
                                "enum": [
                                    "chordNote",
                                    "interval",
                                    "none",
                                    "note",
                                    "pitchClass"
                                ],
                                "type": "string"
                            },
                            "sizes": {
                                "properties": {
                                    "bevel": {
                                        "type": "boolean"
                                    },
                                    "height": {
                                        "type": "number"
                                    },
                                    "radius": {
                                        "type": "number"
                                    },
                                    "ratio": {
                                        "type": "number"
                                    }
                                },
                                "type": "object"
                            },
                            "skin": {
                                "enum": [
                                    "classic",
                                    "flat"
                                ],
                                "type": "string"
                            },
                            "textOpacity": {
                                "type": "number"
                            },
                            "to": {
                                "type": "string"
                            },
                            "wrap": {
                                "type": "boolean"
                            }
                        },
                        "type": "object"
                    },
                    "useSustain": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "type": "array"
        },
        "chordQuiz": {
            "properties": {
                "chordNotation": {
                    "enum": [
                        "long",
                        "preferred",
                        "short",
                        "symbol"
                    ],
                    "type": "string"
                },
                "chords": {
                    "description": "Chord types asked in the chord quiz (\"all\" uses the difficulty)",
                    "enum": [
                        "all",
                        "majorMinor",
                        "ninths",
                        "sevenths",
                        "triads",
                        "triadsSevenths"
                    ],
                    "type": "string"
                },
                "customProgressions": {
                    "description": "progressions written by the user, one per line (e.g. \"I vi ii V\")",
                    "type": "string"
                },
                "difficulty": {
                    "enum": [
                        0,
                        1,
                        2,
                        3,
                        4,
                        5
                    ],
                    "type": "number"
                },
                "displayIntervals": {
                    "type": "boolean"
                },
                "displayName": {
                    "type": "boolean"
                },
                "displayReaction": {
                    "type": "boolean"
                },
                "displayRelative": {
                    "type": "boolean"
                },
                "excludedChords": {
                    "description": "chords of the set left out (tonal names, e.g. \"m\" or \"dim\")",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "excludedProgressions": {
                    "description": "progressions left out (ids, e.g. \"ii-V-I\")",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "fingering": {
                    "description": "Hands to display finger numbers for, in learning modes",
                    "enum": [
                        "both",
                        "left",
                        "none",
                        "right"
                    ],
                    "type": "string"
                },
                "gameLength": {
                    "type": "number"
                },
                "gamification": {
                    "type": "boolean"
                },
                "learningMode": {
                    "type": "boolean"
                },
                "mode": {
                    "description": "\"rhythm\" is from before the Rhythm Game had its own module (read as \"random\")",
                    "enum": [
                        "progressions",
                        "random",
                        "randomInKey",
                        "rhythm"
                    ],
                    "type": "string"
                },
                "progressionKey": {
                    "description": "key of the progressions: random, or the current key (notation settings)",
                    "enum": [
                        "current",
                        "random"
                    ],
                    "type": "string"
                },
                "retryUntilCorrect": {
                    "description": "stays on the chord after a wrong answer, until the right chord is played",
                    "type": "boolean"
                },
                "tonics": {
                    "description": "Tonics asked in quizzes: every key, or natural keys only (no sharp or flat)",
                    "enum": [
                        "all",
                        "natural"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "circleOfFifths": {
            "properties": {
                "displayAlterations": {
                    "type": "boolean"
                },
                "displayDegreeLabels": {
                    "type": "boolean"
                },
                "displayDegrees": {
                    "type": "boolean"
                },
                "displayDiminished": {
                    "type": "boolean"
                },
                "displayDominants": {
                    "type": "boolean"
                },
                "displayMajor": {
                    "type": "boolean"
                },
                "displayMinor": {
                    "type": "boolean"
                },
                "displayModes": {
                    "type": "boolean"
                },
                "displaySuspended": {
                    "type": "boolean"
                },
                "highlightInScale": {
                    "type": "boolean"
                },
                "highlightSector": {
                    "enum": [
                        "chord",
                        "notes"
                    ],
                    "type": "string"
                },
                "scale": {
                    "enum": [
                        "major",
                        "minor"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "general": {
            "properties": {
                "launchAtStartup": {
                    "type": "boolean"
                },
                "playNotes": {
                    "description": "built-in sound: the notes played on the MIDI keyboard are heard",
                    "type": "boolean"
                },
                "soundVolume": {
                    "description": "built-in sound: volume from 0 to 100",
                    "type": "number"
                },
                "startMinimized": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "notation": {
            "properties": {
                "accidentals": {
                    "enum": [
                        "flat",
                        "sharp"
                    ],
                    "type": "string"
                },
                "key": {
                    "type": "string"
                },
                "staffClef": {
                    "enum": [
                        "bass",
                        "both",
                        "treble"
                    ],
                    "type": "string"
                },
                "staffTranspose": {
                    "type": "number"
                }
            },
            "type": "object"
        },
        "rhythmGame": {
            "properties": {
                "customSongs": {
                    "description": "songs imported from chord sheets or web pages (chords in their key)",
                    "items": {
                        "description": "A song imported from a ChordPro file or a chord sheet",
                        "properties": {
                            "beats": {
                                "description": "length of each chord in beats (from bar lines), one bar each if not given",
                                "items": {
                                    "type": "number"
                                },
                                "type": "array"
                            },
                            "beatsPerBar": {
                                "description": "beats in a bar (time signature: 3 for 3/4)",
                                "type": "number"
                            },
                            "beatsPerHit": {
                                "description": "the song's own rhythm: a chord is played every N beats (from the strumming)",
                                "type": "number"
                            },
                            "bpm": {
                                "description": "tempo of the song (beats per minute)",
                                "type": "number"
                            },
                            "chords": {
                                "description": "chord names in order, e.g. [\"G\", \"Em7\", \"C\", \"D\"]",
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            "id": {
                                "type": "string"
                            },
                            "key": {
                                "description": "key of the song, e.g. \"G\" or \"Em\" (from the file, or the first chord)",
                                "type": "string"
                            },
                            "sections": {
                                "description": "parts of the song (verse, chorus...): their name and the index of their first chord",
                                "items": {
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "start": {
                                            "type": "number"
                                        }
                                    },
                                    "type": "object"
                                },
                                "type": "array"
                            },
                            "title": {
                                "type": "string"
                            },
                            "url": {
                                "description": "web address the song was imported from (to import it again)",
                                "type": "string"
                            }
                        },
                        "type": "object"
                    },
                    "type": "array"
                },
                "excludedSongs": {
                    "description": "songs left out (ids)",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "fingering": {
                    "description": "Hands to display finger numbers for, in learning modes",
                    "enum": [
                        "both",
                        "left",
                        "none",
                        "right"
                    ],
                    "type": "string"
                },
                "gamification": {
                    "type": "boolean"
                },
                "learningMode": {
                    "type": "boolean"
                },
                "onMiss": {
                    "description": "learning mode: on a miss, keep going, wait for the chord, or slow down",
                    "enum": [
                        "continue",
                        "slowDown",
                        "wait"
                    ],
                    "type": "string"
                },
                "pattern": {
                    "description": "chords played in the rhythm of the song, once per bar, twice, or on every beat",
                    "enum": [
                        "bar",
                        "beat",
                        "half",
                        "song"
                    ],
                    "type": "string"
                },
                "showTitle": {
                    "description": "the song name is shown from the start, or revealed at the end",
                    "enum": [
                        "end",
                        "start"
                    ],
                    "type": "string"
                },
                "song": {
                    "description": "the song to play (id), or \"\" for a random song",
                    "type": "string"
                },
                "songKey": {
                    "description": "key of the built-in songs: random, or the current key (notation settings)",
                    "enum": [
                        "current",
                        "random"
                    ],
                    "type": "string"
                },
                "songTempo": {
                    "description": "songs with a tempo of their own (imported) are played at it",
                    "type": "boolean"
                },
                "sound": {
                    "description": "built-in sound: the chords of the song, a click on the beat, both, or nothing",
                    "enum": [
                        "both",
                        "chords",
                        "click",
                        "off"
                    ],
                    "type": "string"
                },
                "speedUp": {
                    "description": "the song speeds up (5% every 4 hits in a row, up to 1.5 times)",
                    "type": "boolean"
                },
                "tempo": {
                    "description": "beats per minute",
                    "type": "number"
                },
                "tonics": {
                    "description": "Tonics asked in quizzes: every key, or natural keys only (no sharp or flat)",
                    "enum": [
                        "all",
                        "natural"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "scaleDegrees": {
            "properties": {
                "displayDegreeName": {
                    "type": "boolean"
                },
                "displayReaction": {
                    "type": "boolean"
                },
                "displayRelative": {
                    "type": "boolean"
                },
                "displayScaleNotes": {
                    "type": "boolean"
                },
                "gameLength": {
                    "type": "number"
                },
                "gamification": {
                    "type": "boolean"
                },
                "learningMode": {
                    "description": "keyboard with the keys of the scale and their degrees",
                    "type": "boolean"
                },
                "mode": {
                    "enum": [
                        "random",
                        "randomInKey"
                    ],
                    "type": "string"
                },
                "scales": {
                    "enum": [
                        "all",
                        "major",
                        "majorMinor",
                        "minor",
                        "minors",
                        "modes",
                        "pentatonics"
                    ],
                    "type": "string"
                },
                "tonics": {
                    "description": "Tonics asked in quizzes: every key, or natural keys only (no sharp or flat)",
                    "enum": [
                        "all",
                        "natural"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "scaleQuiz": {
            "properties": {
                "direction": {
                    "enum": [
                        "down",
                        "up",
                        "upDown"
                    ],
                    "type": "string"
                },
                "displayFormula": {
                    "type": "boolean"
                },
                "displayNoteNames": {
                    "type": "boolean"
                },
                "displayReaction": {
                    "type": "boolean"
                },
                "displayRelative": {
                    "type": "boolean"
                },
                "excludedMelodies": {
                    "description": "melodies left out (ids)",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "fingering": {
                    "description": "Hands to display finger numbers for, in learning modes",
                    "enum": [
                        "both",
                        "left",
                        "none",
                        "right"
                    ],
                    "type": "string"
                },
                "gamification": {
                    "type": "boolean"
                },
                "jumpBack": {
                    "type": "boolean"
                },
                "learningMode": {
                    "type": "boolean"
                },
                "mode": {
                    "enum": [
                        "random",
                        "randomInKey",
                        "sequential"
                    ],
                    "type": "string"
                },
                "practice": {
                    "description": "play scales, melodies of songs, or random solo phrases (over a backing track)",
                    "enum": [
                        "melodies",
                        "scales",
                        "solo"
                    ],
                    "type": "string"
                },
                "requiredCleanRuns": {
                    "type": "number"
                },
                "scales": {
                    "enum": [
                        "all",
                        "major",
                        "majorMinor",
                        "minor",
                        "minors",
                        "modes",
                        "pentatonics"
                    ],
                    "type": "string"
                },
                "soloKey": {
                    "description": "solo: key, as a chroma (\"0\" = C ... \"11\" = B) or \"current\" (notation settings)",
                    "type": "string"
                },
                "soloLength": {
                    "description": "solo: number of notes of a phrase",
                    "enum": [
                        "long",
                        "medium",
                        "short"
                    ],
                    "type": "string"
                },
                "soloScale": {
                    "description": "solo: scale the phrases are made of (tonal name, e.g. \"minor pentatonic\")",
                    "type": "string"
                },
                "tonics": {
                    "description": "Tonics asked in quizzes: every key, or natural keys only (no sharp or flat)",
                    "enum": [
                        "all",
                        "natural"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "server": {
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "port": {
                    "type": "number"
                }
            },
            "type": "object"
        }
    },
    "type": "object"
}

